# Абсолютный адрес сайта — используется в canonical, hreflang, JSON-LD,
# sitemap.xml и robots.txt. Пока домена нет — можно не создавать .env.production
# вообще (тогда используется заглушка http://localhost:3000).
# После покупки домена: скопировать этот файл в .env.production, вписать
# реальный адрес и пересобрать проект (npm run build) — значение "зашивается"
# в сборку, простого перезапуска процесса недостаточно.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Опционально: коды подтверждения прав на сайт для Google Search Console
# и Yandex Webmaster. Добавляются после регистрации сайта в каждом сервисе
# (раздел проверки прав → способ "HTML-тег" → скопировать только само
# значение content, без окружающего <meta ...>). Если переменная не задана,
# соответствующий тег просто не добавляется на страницу — код трогать не нужно.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
